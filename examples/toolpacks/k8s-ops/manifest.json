{
  "name": "k8s-ops",
  "description": "Kubernetes operations toolpack for managing deployments, Helm charts, and container images",
  "version": "1.0.0",
  "author": "ToolForge Team",
  "runtime_image": "k3s-helm-docker",
  "tools": [
    {
      "name": "k8s_deploy",
      "description": "Deploy a Kubernetes manifest or Helm chart",
      "input_schema": {
        "type": "object",
        "properties": {
          "manifest": {
            "type": "string",
            "description": "Kubernetes YAML manifest or path to Helm chart"
          },
          "namespace": {
            "type": "string",
            "description": "Target namespace",
            "default": "default"
          },
          "values": {
            "type": "object",
            "description": "Values for Helm chart (if applicable)"
          }
        },
        "required": ["manifest"]
      }
    },
    {
      "name": "k8s_status",
      "description": "Check status of Kubernetes resources",
      "input_schema": {
        "type": "object",
        "properties": {
          "resource_type": {
            "type": "string",
            "description": "Type of resource (pods, deployments, services, etc.)",
            "default": "pods"
          },
          "namespace": {
            "type": "string",
            "description": "Target namespace",
            "default": "default"
          },
          "labels": {
            "type": "string",
            "description": "Label selector"
          }
        }
      }
    },
    {
      "name": "docker_build_push",
      "description": "Build and push a Docker image",
      "input_schema": {
        "type": "object",
        "properties": {
          "dockerfile": {
            "type": "string",
            "description": "Path to Dockerfile or Dockerfile content"
          },
          "tag": {
            "type": "string",
            "description": "Image tag",
            "default": "latest"
          },
          "registry": {
            "type": "string",
            "description": "Docker registry URL"
          },
          "context": {
            "type": "string",
            "description": "Build context directory"
          }
        },
        "required": ["dockerfile"]
      }
    }
  ],
  "requirements": [
    "kubernetes >= 1.0",
    "docker >= 20.10",
    "helm >= 3.12"
  ],
  "license": "MIT"
}