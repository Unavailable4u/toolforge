  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "action": {
        "enum": [
          "new",
          "move",
          "show"
        ],
        "type": "string"
      },
      "direction": {
        "enum": [
          "left",
          "down",
          "right",
          "up"
        ],
        "type": "string"
      },
      "map": {
        "enum": [
          "4x4",
          "8x8"
        ],
        "type": "string"
      },
      "seed": {
        "maximum": 2147483647,
        "minimum": 0,
        "type": "integer"
      },
      "slippery": {
        "type": "boolean"
      }
    },
    "required": [
      "action"
    ],
    "type": "object"
  },
  "kind": "session",
  "limits": {
    "memory_mb": 256,
    "output_kb": 64,
    "timeout_s": 20
  },
  "name": "frozenlake_session",
  "output_schema": {
    "additionalProperties": false,
    "properties": {
      "directions": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "done": {
        "type": "boolean"
      },
      "grid": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "outcome": {
        "enum": [
          "playing",
          "won",
          "fell",
          "timeout"
        ],
        "type": "string"
      },
      "position": {
        "items": {
          "type": "integer"
        },
        "type": "array"
      },
      "reward": {
        "type": "number"
      },
      "steps": {
        "type": "integer"
      }
    },
    "required": [
      "grid",
      "position",
      "steps",
      "done",
      "reward",
      "outcome",
      "directions"
    ],
    "type": "object"
  },
  "parent_version": null,
