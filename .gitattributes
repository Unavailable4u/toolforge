# Keep line endings identical on every platform. CRLF breaks `git am`, deterministic tar hashes and shell scripts.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.svg text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.png binary
*.gz binary
*.tfbundle binary
