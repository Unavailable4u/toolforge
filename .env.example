# Copy to .env (git-ignored) and edit. Every setting is optional; the values below are the defaults.
# Secrets (keys, tokens) belong only in .env or the process environment, never in the repository.

# Data directory: registry, blobs, ledgers, approvals.
# TOOLFORGE_HOME=~/.toolforge

# Override for third_party/minilocker/backend (see docs/guide/03-minilocker-integration.md).
# TOOLFORGE_MINILOCKER_PATH=

# Image used for tool sandboxes.
# TOOLFORGE_RUNTIME_IMAGE=python:3.12-slim

# Comma-separated hosts reachable during the build gate (installing pinned requirements).
# TOOLFORGE_BUILD_ALLOW=pypi.org,files.pythonhosted.org

# Cap on a package's total source size, in KB.
# TOOLFORGE_MAX_PACKAGE_KB=256

# Per-call timeout (seconds) and memory (MB) when a manifest sets none.
# TOOLFORGE_DEFAULT_TIMEOUT_S=20
# TOOLFORGE_DEFAULT_MEMORY_MB=256

# How many verifications may run at once.
# TOOLFORGE_MAX_CONCURRENT_VERIFICATIONS=2

# Promote tools with no sensitive permissions automatically once every gate passed.
# TOOLFORGE_AUTO_PROMOTE=true

# Plant decoy credentials in every call sandbox, to catch a tool that goes looking for secrets. A call that touches one fails with
# PolicyViolation and the active version is quarantined until an operator runs `toolforge release`. Off means no tripwire.
# TOOLFORGE_RUNTIME_DECOYS=true

# Also expose each active tool as its own MCP tool (tf_<name>), except tools that take caller files; use forge_run for those.
# TOOLFORGE_EXPOSE_DIRECT=false

# Pending approvals become denials after this many seconds.
# TOOLFORGE_APPROVAL_TIMEOUT_S=900

# DEBUG, INFO, WARNING, ERROR or CRITICAL. Logs go to stderr, never to stdout in stdio mode.
# TOOLFORGE_LOG_LEVEL=INFO

# Builder model: any OpenAI-compatible chat endpoint. Leave unset to run without a model.
# TOOLFORGE_LLM_BASE_URL=
# TOOLFORGE_LLM_MODEL=
# TOOLFORGE_LLM_API_KEY=

# Challenger model. Falls back to the builder values above. A different model is recommended.
# TOOLFORGE_CHALLENGER_BASE_URL=
# TOOLFORGE_CHALLENGER_MODEL=
# TOOLFORGE_CHALLENGER_API_KEY=

# Client-side limits for model requests: requests per minute (0 means no limit) and seconds one request may take. A free tier that
# answers HTTP 429 is why the limit exists: the client spaces its requests, backs off, honours Retry-After, and gate G5 is skipped
# (never failed, never passed) when the provider stays unavailable. The challenger uses its own limit, or the builder's while it
# shares the builder's endpoint.
# TOOLFORGE_LLM_MAX_RPM=0
# TOOLFORGE_CHALLENGER_MAX_RPM=0
# TOOLFORGE_LLM_TIMEOUT_S=60

# The server-side builder (forge_build, `toolforge build`): how many times it may ask the model for a package (a failed package goes
# back to the model with the failed gate's summary and hints), and the most model tokens one build may spend in all. A build stops at
# either limit, and sooner when two rounds in a row fail the same way. When the provider reports no token counts the budget is
# counted with an estimate (about four characters a token) and the result says so.
# TOOLFORGE_BUILDER_MAX_ROUNDS=4
# TOOLFORGE_BUILDER_TOKEN_BUDGET=60000

# Repair (forge_repair): the most repair attempts that may start on one tool in an hour (a confused agent cannot spin the registry), and
# whether the raw arguments of a call that crashed, timed out or killed its sandbox are stored, so that the next version is tested against
# them. Off by default: arguments are what callers sent, possibly personal data, and stored ones sit unencrypted in registry.sqlite3 (at most
# 20 per tool, each under 8 KB, none with secret-shaped text). With it off, only a shape fingerprint (types and sizes, never values) is kept.
# TOOLFORGE_REPAIR_MAX_PER_HOUR=3
# TOOLFORGE_STORE_FAILED_INPUTS=false

# Sessions (session tools keep one sandbox open across calls, docs/sessions.md): seconds without a call before a session closes,
# the longest a session may live, and how many may be open at once. An open call waits a few seconds for a free slot, then fails.
# TOOLFORGE_SESSION_TTL_S=900
# TOOLFORGE_SESSION_MAX_S=3600
# TOOLFORGE_MAX_SESSIONS=4

# MCP HTTP transport. A token is required on any non-loopback host.
# TOOLFORGE_SERVER_HOST=127.0.0.1
# TOOLFORGE_SERVER_PORT=8765
# TOOLFORGE_SERVER_TOKEN=
# Extra Origin and Host header values the HTTP listener accepts (comma-separated), for a browser client or a
# non-loopback address. Loopback origins and the address the server is bound to are always accepted.
# TOOLFORGE_SERVER_ALLOWED_ORIGINS=
# TOOLFORGE_SERVER_ALLOWED_HOSTS=

# Operator dashboard, same rules.
# TOOLFORGE_DASHBOARD_HOST=127.0.0.1
# TOOLFORGE_DASHBOARD_PORT=8787
# TOOLFORGE_DASHBOARD_TOKEN=
