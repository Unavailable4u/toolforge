1|# Copy to .env (git-ignored) and edit. Every setting is optional; the values below are the defaults.
2|# Secrets (keys, tokens) belong only in .env or the process environment, never in the repository.
3|
4|# Data directory: registry, blobs, ledgers, approvals.
5|# TOOLFORGE_HOME=~/.toolforge
6|
7|# Override for third_party/minilocker/backend (see docs/guide/03-minilocker-integration.md).
8|# TOOLFORGE_MINILOCKER_PATH=
9|
10|# Image used for tool sandboxes.
11|# TOOLFORGE_RUNTIME_IMAGE=toolforge-runtime:py312
12|
13|# Comma-separated hosts reachable during the build gate (installing pinned requirements).
14|# TOOLFORGE_BUILD_ALLOW=pypi.org,files.pythonhosted.org
15|
16|# Cap on a package's total source size, in KB.
17|# TOOLFORGE_MAX_PACKAGE_KB=256
18|
19|# Per-call timeout (seconds) and memory (MB) when a manifest sets none.
20|# TOOLFORGE_DEFAULT_TIMEOUT_S=20
21|# TOOLFORGE_DEFAULT_MEMORY_MB=256
22|
23|# How many verifications may run at once.
24|# TOOLFORGE_MAX_CONCURRENT_VERIFICATIONS=2
25|
26|# Promote tools with no sensitive permissions automatically once every gate passed.
27|# TOOLFORGE_AUTO_PROMOTE=true
28|
29|# Plant decoy credentials in every call sandbox, to catch a tool that goes looking for secrets. A call that touches one fails with
30|# PolicyViolation and the active version is quarantined until an operator runs `toolforge release`. Off means no tripwire.
31|# TOOLFORGE_RUNTIME_DECOYS=true
32|
33|# Also expose each active tool as its own MCP tool (tf_<name>), except tools that take caller files; use forge_run for those.
34|# TOOLFORGE_EXPOSE_DIRECT=false
35|
36|# Pending approvals become denials after this many seconds.
37|# TOOLFORGE_APPROVAL_TIMEOUT_S=900
38|
39|# DEBUG, INFO, WARNING, ERROR or CRITICAL. Logs go to stderr, never to stdout in stdio mode.
40|# TOOLFORGE_LOG_LEVEL=INFO
41|
42|# Builder model: any OpenAI-compatible chat endpoint. Leave unset to run without a model.
43|# TOOLFORGE_LLM_BASE_URL=
44|# TOOLFORGE_LLM_MODEL=
45|# TOOLFORGE_LLM_API_KEY=
46|
47|# Challenger model. Falls back to the builder values above. A different model is recommended.
48|# TOOLFORGE_CHALLENGER_BASE_URL=
49|# TOOLFORGE_CHALLENGER_MODEL=
50|# TOOLFORGE_CHALLENGER_API_KEY=
51|
52|# Client-side limits for model requests: requests per minute (0 means no limit) and seconds one request may take. A free tier that
53|# answers HTTP 429 is why the limit exists: the client spaces its requests, backs off, honours Retry-After, and gate G5 is skipped
54|# (never failed, never passed) when the provider stays unavailable. The challenger uses its own limit, or the builder's while it
55|# shares the builder's endpoint.
56|# TOOLFORGE_LLM_MAX_RPM=0
57|# TOOLFORGE_CHALLENGER_MAX_RPM=0
58|# TOOLFORGE_LLM_TIMEOUT_S=60
59|
60|# The server-side builder (forge_build, `toolforge build`): how many times it may ask the model for a package (a failed package goes
61|# back to the model with the failed gate's summary and hints), and the most model tokens one build may spend in all. A build stops at
62|# either limit, and sooner when two rounds in a row fail the same way. When the provider reports no token counts the budget is
63|# counted with an estimate (about four characters a token) and the result says so.
64|# TOOLFORGE_BUILDER_MAX_ROUNDS=4
65|# TOOLFORGE_BUILDER_TOKEN_BUDGET=60000
66|
67|# Repair (forge_repair): the most repair attempts that may start on one tool in an hour (a confused agent cannot spin the registry), and
68|# whether the raw arguments of a call that crashed, timed out or killed its sandbox are stored, so that the next version is tested against
69|# them. Off by default: arguments are what callers sent, possibly personal data, and stored ones sit unencrypted in registry.sqlite3 (at most
70|# 20 per tool, each under 8 KB, none with secret-shaped text). With it off, only a shape fingerprint (types and sizes, never values) is kept.
71|# TOOLFORGE_REPAIR_MAX_PER_HOUR=3
72|# TOOLFORGE_STORE_FAILED_INPUTS=false
73|
74|# Sessions (session tools keep one sandbox open across calls, docs/sessions.md): seconds without a call before a session closes,
75|# the longest a session may live, and how many may be open at once. An open call waits a few seconds for a free slot, then fails.
76|# TOOLFORGE_SESSION_TTL_S=900
77|# TOOLFORGE_SESSION_MAX_S=3600
78|# TOOLFORGE_MAX_SESSIONS=4
79|
80|# MCP HTTP transport. A token is required on any non-loopback host.
81|# TOOLFORGE_SERVER_HOST=127.0.0.1
82|# TOOLFORGE_SERVER_PORT=8765
83|# TOOLFORGE_SERVER_TOKEN=
84|# Extra Origin and Host header values the HTTP listener accepts (comma-separated), for a browser client or a
85|# non-loopback address. Loopback origins and the address the server is bound to are always accepted.
86|# TOOLFORGE_SERVER_ALLOWED_ORIGINS=
87|# TOOLFORGE_SERVER_ALLOWED_HOSTS=
88|
89|# Operator dashboard, same rules.
90|# TOOLFORGE_DASHBOARD_HOST=127.0.0.1
91|# TOOLFORGE_DASHBOARD_PORT=8787
92|# TOOLFORGE_DASHBOARD_TOKEN=